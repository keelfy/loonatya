# Bind to localhost when using an existing reverse proxy on the VDS.
# For direct public HTTP, set HTTP_BIND=0.0.0.0 and HTTP_PORT=80.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# For an existing Docker Traefik, uncomment these instead of using host ports.
# COMPOSE_FILE=compose.traefik.yml
# SITE_DOMAIN=loonatya.example.com
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
